pkgname=twinforge
pkgver=0.2.0
pkgrel=1
pkgdesc='TwinForge — Modern dual-panel file manager for Linux'
arch=('x86_64' 'aarch64')
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'libarchive' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
provides=('twinforge')
conflicts=('twinforge-git' 'twinforge-bin' 'omapanel')
replaces=('omapanel')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/twinforge "$pkgdir/usr/bin/twinforge"
  ln -s twinforge "$pkgdir/usr/bin/tf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/twinforge.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/twinforge.svg"
  install -Dm644 "$startdir/twinforge.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/twinforge.png"
  install -Dm644 "$startdir/twinforge.desktop" "$pkgdir/usr/share/applications/twinforge.desktop"
}
